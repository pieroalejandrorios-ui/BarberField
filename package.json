{
  "name": "barber-loyalty-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:config",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:supabase": "node scripts/check-supabase.mjs",
    "check:config": "node scripts/check-deployment.mts",
    "check:release": "node scripts/check-deployment.mts --production",
    "check": "npm run lint && npm run test:unit && npm run test:db && npm run build",
    "prepare:supabase": "node scripts/prepare-supabase-sql.mjs",
    "test:db": "node --test \"tests/db/**/*.test.mts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.mts\""
  },
  "engines": { "node": ">=22.18.0" },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
