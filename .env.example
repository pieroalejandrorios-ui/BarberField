# Copia este archivo a .env.local y completa los valores desde Supabase > Connect.
NEXT_PUBLIC_SUPABASE_URL=
# Usa la clave publishable (o anon heredada), nunca secret ni service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# development local; preview para pruebas; production para la aplicación publicada.
APP_ENV=development
# URL base de la aplicación, sin rutas. Producción exige el dominio HTTPS real.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Identificador no secreto del Supabase de producción. Usar un proyecto distinto
# en desarrollo/preview. check:release exige este valor y comprueba el destino.
SUPABASE_PRODUCTION_PROJECT_REF=
